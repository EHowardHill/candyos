// CandyOS: the Testing app - a KitKat-styled test bench for every
// CandyOS-specific surface (P23):
//   * the 4.4 ticker (post long/short/burst/group/ongoing notifications)
//   * the Holo widget skins (ghost button, switch, checkboxes, radios,
//     seekbar, progress bars, spinner, text field - the app runs on
//     Theme.DeviceDefault, which the P1 series re-based onto Holo, so the
//     whole app doubles as a live theme-cascade test)
//   * the 2013 Roboto families and the hybrid blob-emoji font chain
//   * Holo dialogs and toasts, the volume panel, immersive mode,
//     the 4.4 activity transitions and KitKatRecentsActivity
// Plain unprivileged app, public framework APIs only (sdk_version:
// current, no androidx dependency). Installs to the PRODUCT partition
// like the partner_gms apps: the sdk_phone emulator target enforces the
// AOSP generic-system artifact-path requirement, which forbids new
// files under system/. The notification channel exists because the
// platform targetSdk (34) requires one.
android_app {
    name: "Testing",
    srcs: ["src/**/*.java"],
    product_specific: true,
    sdk_version: "current",
}

// Pre-grant POST_NOTIFICATIONS (see the XML for why). Same mechanism as
// the partner_gms default-permissions files: scanned by the package
// manager at boot from /product/etc/default-permissions/.
prebuilt_etc {
    name: "default-permissions-com.candyos.testing",
    product_specific: true,
    relative_install_path: "default-permissions",
    // The package manager only scans *.xml in default-permissions/, but
    // soong names the output after the module - keep the extension.
    filename: "default-permissions-com.candyos.testing.xml",
    src: "default-permissions-com.candyos.testing.xml",
}
