    <!-- Second activity -->
    <string name="second_title">Second Activity</string>
    <string name="second_explanation">The transition that opened this activity used the ported 4.4 activity-open animation. Press RECENTS now to see the KitKat vertical card list — this activity appears as a card with its icon and title; dismissing the card and tapping back exercise the donor behaviors. Finishing plays the 4.4 close animation.</string>
