<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.candyos.testing">

    <!-- targetSdk is 34, so without this runtime permission the NMS ranks
         the app IMPORTANCE_NONE: no shade entries, and the SystemUI
         NotificationListener never sees the posts - which also silences
         the 4.4 ticker test. Requested at runtime on first post; the
         permission dialog itself is a Holo-styled surface. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher_testing"
        android:theme="@android:style/Theme.DeviceDefault"
        android:allowBackup="false">

        <activity
            android:name=".TestingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SecondActivity"
            android:label="@string/second_name"
            android:exported="false" />
    </application>
</manifest>
