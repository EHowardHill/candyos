# CandyOS bundled "GMS": Google services via MindTheGapps
# (<https://wiki.lineageos.org/gapps/>) plus the open-source Maps app
# (docs/apps.md), shipped as prebuilt, PRESIGNED product-partition blobs.
#
# This file is picked up by the stock LineageOS hook
# vendor/lineage/config/partner_gms.mk when WITH_GMS is true (the flag is
# set by patches/vendor-lineage/). The blobs are fetched and the per-arch
# makefiles generated by scripts/candyos-fetch-apps.sh (which runs
# scripts/candyos-gen-gapps-mk.py); none of it is committed to this repo.

PRODUCT_PACKAGES += \
    OrganicMaps

# Google services are arch-conditional: MindTheGapps ships arm/arm64 APKs
# only, so x86/x86_64 targets - the emulator QA images - intentionally
# build WITHOUT GApps (vendor/partner_gms/README.md). The per-arch
# gapps-packages.mk is generated from the fetched MindTheGapps tree.
ifneq (,$(filter arm arm64,$(TARGET_ARCH)))
-include vendor/partner_gms/gapps-$(TARGET_ARCH)/gapps-packages.mk
endif