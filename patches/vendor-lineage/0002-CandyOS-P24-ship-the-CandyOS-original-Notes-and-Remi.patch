From: Ethan Hill <ethan.hill1999@outlook.com>
Date: Mon, 26 Oct 2026 20:27:45 -0500
Subject: [PATCH 2/5] CandyOS P24: ship the CandyOS-original Notes and
 Reminders apps (Maps moves to the prebuilt Organic Maps APK)

Change-Id: I5cd79aac96fb3fbeef2af329269fac67f00115d5
---
 config/common.mk | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/config/common.mk b/config/common.mk
index 04533d44..d5e1e398 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -264,6 +264,14 @@ include vendor/lineage/config/version.mk
 -include vendor/lineage-priv/keys/keys.mk
 
 -include $(WORKSPACE)/build_env/image-auto-bits.mk
+# CandyOS: first-boot app set completion (docs/apps.md) - the
+# CandyOS-original Notes and Reminders apps, vendored from apps/ into
+# packages/apps/ by candyos-sync.sh. (Maps is the prebuilt Organic Maps
+# APK, shipped via vendor/partner_gms/products/gms.mk.)
+PRODUCT_PACKAGES += \
+    CandyNotes \
+    CandyReminders
+
 # CandyOS: bundle MindTheGapps GApps and Organic Maps from vendor/partner_gms
 WITH_GMS := true
 
