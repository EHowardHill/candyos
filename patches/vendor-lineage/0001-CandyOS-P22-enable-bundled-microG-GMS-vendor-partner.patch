From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ethan Hill <ethan.hill1999@outlook.com>
Date: Fri, 23 Oct 2026 13:13:59 -0500
Subject: [PATCH 1/3] CandyOS P22: enable bundled Google services
 (vendor/partner_gms)

Turn on the stock LineageOS WITH_GMS hook so the CandyOS-vendored
vendor/partner_gms overlay (MindTheGapps Google services + Play Store,
plus Organic Maps) is inherited into every CandyOS product.
partner_gms.mk itself stays stock - it only reads the WITH_GMS flag
that is now set.
---
 config/common.mk | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/config/common.mk b/config/common.mk
index 9bb749e4..79eb79be 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -264,4 +264,7 @@ include vendor/lineage/config/version.mk
 -include vendor/lineage-priv/keys/keys.mk
 
 -include $(WORKSPACE)/build_env/image-auto-bits.mk
+# CandyOS: bundle MindTheGapps GApps and Organic Maps from vendor/partner_gms
+WITH_GMS := true
+
 -include vendor/lineage/config/partner_gms.mk
-- 
