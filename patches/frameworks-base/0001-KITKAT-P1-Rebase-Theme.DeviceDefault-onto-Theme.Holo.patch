 core/res/res/values/dimens.xml                |   4 +-
 .../res/res/values/styles_device_defaults.xml | 352 +++++++++---------
 .../res/res/values/themes_device_defaults.xml | 152 ++++----
 .../theme/ThemeOverlayController.java         |   9 +-
 5 files changed, 274 insertions(+), 251 deletions(-)

