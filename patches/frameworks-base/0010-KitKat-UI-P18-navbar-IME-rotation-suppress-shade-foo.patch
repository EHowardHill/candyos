+            if (drawable.getRotation() != 0f) {
+                ObjectAnimator.ofPropertyValuesHolder(drawable,
+                        PropertyValuesHolder.ofFloat(KeyButtonDrawable.KEY_DRAWABLE_ROTATE, 0f),
+                        PropertyValuesHolder.ofFloat(KeyButtonDrawable.KEY_DRAWABLE_TRANSLATE_Y,
+                                0f))
+                        .setDuration(200).start();
+            }
             return;
         }
-
-        if (isGesturalMode(mNavBarMode)) {
-            drawable.setRotation(degrees);
+        float degrees = useAltBack ? (isRtl ? 90 : -90) : 0;
+        if (drawable.getRotation() == degrees) {
             return;
         }
 
-        // Animate the back button's rotation to the new degrees and only in portrait move up the
-        // back button to line up with the other buttons
-        float targetY = !mShowSwipeUpUi && !mIsVertical && useAltBack
-                ? - getResources().getDimension(R.dimen.navbar_back_button_ime_offset)
-                : 0;
-        ObjectAnimator navBarAnimator = ObjectAnimator.ofPropertyValuesHolder(drawable,
-                PropertyValuesHolder.ofFloat(KeyButtonDrawable.KEY_DRAWABLE_ROTATE, degrees),
-                PropertyValuesHolder.ofFloat(KeyButtonDrawable.KEY_DRAWABLE_TRANSLATE_Y, targetY));
-        navBarAnimator.setInterpolator(Interpolators.FAST_OUT_SLOW_IN);
-        navBarAnimator.setDuration(200);
-        navBarAnimator.start();
+        drawable.setRotation(degrees);
     }
 
     private void orientHomeButton(KeyButtonDrawable drawable) {
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/notification/footer/ui/view/FooterView.java b/packages/SystemUI/src/com/android/systemui/statusbar/notification/footer/ui/view/FooterView.java
index 96eaaa9f31ea..bda5fae6a336 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/notification/footer/ui/view/FooterView.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/notification/footer/ui/view/FooterView.java
@@ -265,6 +265,23 @@ public class FooterView extends StackScrollerDecorView {
         }
     }
 
+    /**
+     * KitKat UI P18.3: donor fidelity - the manage/history footer button is
+     * retired (the 4.4 shade had no such button; clear-all lives in the
+     * header X). Plain GONE; re-enabling is the FooterViewModel flip.
+     */
+    public void setManageButtonVisible(boolean visible, boolean animate) {
+        setManageButtonVisible(visible, animate, null);
+    }
+
+    public void setManageButtonVisible(boolean visible, boolean animate,
+            Consumer<Boolean> onAnimationEnded) {
+        mManageOrHistoryButton.setVisibility(visible ? View.VISIBLE : View.GONE);
+        if (onAnimationEnded != null) {
+            onAnimationEnded.accept(visible);
+        }
+    }
+
     /** Set onClickListener for the manage/history button. */
     public void setManageButtonClickListener(OnClickListener listener) {
         mManageOrHistoryButton.setOnClickListener(listener);
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/notification/footer/ui/viewbinder/FooterViewBinder.kt b/packages/SystemUI/src/com/android/systemui/statusbar/notification/footer/ui/viewbinder/FooterViewBinder.kt
index 65ab4fdeb77b..75bc4717bd42 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/notification/footer/ui/viewbinder/FooterViewBinder.kt
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/notification/footer/ui/viewbinder/FooterViewBinder.kt
@@ -141,8 +141,26 @@ object FooterViewBinder {
             }
         }
 
-        // NOTE: The manage/history button is always visible as long as the footer is visible, no
-        //  need to update the visibility here.
+        launch {
+            // KitKat UI P18.3: donor fidelity - the manage/history button is
+            // hidden (FooterViewModel pins isVisible false); wire the
+            // visibility flow so the flip back on is a one-line change.
+            viewModel.manageOrHistoryButton.isVisible.collect { isVisible ->
+                if (isVisible.isAnimating) {
+                    footer.setManageButtonVisible(
+                        isVisible.value,
+                        /* animate = */ true,
+                    ) { _ ->
+                        isVisible.stopAnimating()
+                    }
+                } else {
+                    footer.setManageButtonVisible(
+                        isVisible.value,
+                        /* animate = */ false,
+                    )
+                }
+            }
+        }
     }
 
     private suspend fun bindMessage(
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/notification/footer/ui/viewmodel/FooterViewModel.kt b/packages/SystemUI/src/com/android/systemui/statusbar/notification/footer/ui/viewmodel/FooterViewModel.kt
