    <!-- Ticker test posts -->
    <string name="test_notif_long">Post long (marquee)</string>
    <string name="test_ticker_long_title">CandyOS Testing — ticker notification with a deliberately very long title that has to scroll (marquee) all the way across the status bar</string>
    <string name="test_ticker_long_text">This post exercises the 4.4 ticker port end to end: the status bar contents crossfade out, the title above and this text marquee through the bar for six seconds each, opening the shade cancels the tick immediately, and further posts chain through the queue one entry at a time. The text is intentionally long enough to overflow the bar so the marquee actually has something to do.</string>
    <string name="test_notif_short">Post short</string>
    <string name="test_ticker_short_title">Short tick</string>
    <string name="test_ticker_short_text">Fits on one line — no marquee needed.</string>
    <string name="test_notif_burst">Post burst of 3 (chaining)</string>
    <string name="test_chain1_title">Ticker chain 1/3</string>
    <string name="test_chain1_text">First of three rapid posts; each entry ticks briefly before the next.</string>
    <string name="test_chain2_title">Ticker chain 2/3</string>
    <string name="test_chain2_text">Second entry; the queue advances only after the current tick ends.</string>
    <string name="test_chain3_title">Ticker chain 3/3</string>
    <string name="test_chain3_text">Third entry; afterwards the status bar contents crossfade back in.</string>
    <string name="test_notif_group">Post group (summary must not tick)</string>
    <string name="test_group_child_title">Group child</string>
    <string name="test_group_child_text">Part of a notification group — this child SHOULD tick.</string>
    <string name="test_group_summary_title">Group summary</string>
    <string name="test_group_summary_text">The group summary post — the ticker must skip it (FLAG_GROUP_SUMMARY filter).</string>
    <string name="test_notif_ongoing">Post ongoing</string>
    <string name="test_ongoing_title">Ongoing notification</string>
    <string name="test_ongoing_text">Sticky test post; clears with Cancel all, not by tapping.</string>
    <string name="test_notif_cancel">Cancel all posted</string>
    <string name="test_perm_needed">Notifications are blocked for CandyOS Experience — allow them in the permission dialog (or Settings > Apps), then tap the button again.</string>

